{
  "name": "@photo-server/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "check": "tsc -b --pretty false",
    "check:api": "openapi-ts -o node_modules/.openapi-check-tmp && diff -r node_modules/.openapi-check-tmp src/api/generated",
    "generate:api": "openapi-ts",
    "test": "vitest run",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.87.1",
    "@tanstack/react-virtual": "^3.13.12",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.2.0",
    "vitest": "^5.0.1"
  }
}
