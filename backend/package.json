{
  "name": "@photo-server/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Node-side tooling for the Python backend: OpenAPI client codegen (docs/openapi-codegen-plan.md Phase 6)",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "generate:api": "openapi-python",
    "check:api": "openapi-python -f openapi-python.check.ts && diff -r --exclude __pycache__ node_modules/.openapi-python-check-tmp src/photo_server/generated"
  },
  "devDependencies": {
    "@hey-api/openapi-python": "0.0.24"
  }
}
