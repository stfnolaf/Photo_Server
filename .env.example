# Copy to .env and fill in your deployment values. Never commit the filled file.
PHOTO_S3_ENDPOINT=http://s3-host:8333
PHOTO_S3_BUCKET=photo-library
PHOTO_S3_ANONYMOUS=true
PHOTO_S3_MULTIPART_EXPIRY_DAYS=2
PHOTO_S3_MULTIPART_EXPIRY_DAYS=2
PHOTO_DATA_DIR=.runtime
PHOTO_API_BIND=0.0.0.0
PHOTO_API_PORT=8000
PHOTO_WEB_BIND=0.0.0.0
PHOTO_WEB_PORT=3000
PHOTO_MAX_BATCH_FILES=1000
PHOTO_MAX_FILE_BYTES=536870912
PHOTO_UPLOAD_WORKERS=4
PHOTO_UPLOAD_ABANDON_SECONDS=86400
PHOTO_UPLOAD_CLEANUP_INTERVAL=60
PHOTO_WORKER_THREADS=4
# Display-only burst grouping thresholds. Both hashes must pass; these do not
# change the conservative semantic-reuse thresholds.
PHOTO_BURST_CLUSTER_PHASH_MAX_DISTANCE=17
PHOTO_BURST_CLUSTER_DHASH_MAX_DISTANCE=15
PHOTO_BURST_CLUSTER_CHROMA_MAX_DISTANCE=0.15
PHOTO_BURST_CLUSTER_CAPTURE_WINDOW_SECONDS=35
# Dedicated worker pools. Onboarding can continue while previews and metadata
# processing drain independently. PHOTO_WORKER_THREADS remains the legacy
# all-in-one worker setting for manual `photo-server worker` runs.
PHOTO_ONBOARDING_WORKERS=4
PHOTO_PROCESSING_WORKERS=2
PHOTO_PREVIEW_WORKERS=2
PHOTO_AI_WORKERS=1
PHOTO_VLLM_MAX_NUM_SEQS=1
PHOTO_UPLOAD_PART_BYTES=8388608
# Comma-separated browser origins, for example http://192.168.8.50:3000
PHOTO_CORS_ORIGINS=

# AI is optional. Leave both service URLs empty for a fully functional
# photo library with analysis jobs waiting in PostgreSQL. For local AI, set
# PHOTO_AI_BASE_URL=http://vllm:8000/v1 and
# PHOTO_FACE_SERVICE_URL=http://face-service:8901. For remote or hosted AI,
# point these at trusted-LAN/TLS services or an OpenAI-compatible provider.
# With a hosted VLM, photo pixels leave the local network; that is an
# operator decision. vLLM is one target among many, not a dependency.
# PHOTO_AI_EXTRA_BODY merges a JSON object into the VLM request for
# provider extensions;
# contract fields (model, messages, temperature, max_tokens, response
# format) always win over it.
# PHOTO_FACE_MODEL_DIR is the host directory Compose mounts read-only into
# face-service. It must contain the verified YuNet, SFace alignment, and
# AdaFace IR101 files produced by the sibling face-scanner.
PHOTO_AI_BASE_URL=http://vllm:8000/v1
PHOTO_AI_MODEL=unsloth/Qwen3-VL-8B-Instruct-bnb-4bit
PHOTO_AI_TIMEOUT_SECONDS=600
PHOTO_AI_API_KEY=
PHOTO_AI_EXTRA_BODY=
PHOTO_VLLM_IMAGE=vllm/vllm-openai:v0.11.2
PHOTO_VLLM_MAX_MODEL_LEN=4096
PHOTO_VLLM_GPU_MEMORY_UTILIZATION=0.70
PHOTO_AI_FACE_MAX_IMAGE_SIDE=2000
PHOTO_AI_VLM_MAX_IMAGE_SIDE=1280
PHOTO_FACE_MODEL_DIR=../face-scanner/runtime/raw-jpeg/models
PHOTO_FACE_SERVICE_URL=http://face-service:8901
PHOTO_FACE_SERVICE_TOKEN=replace-with-a-shared-face-service-token
PHOTO_FACE_SERVICE_TIMEOUT=120
PHOTO_FACE_SERVICE_CONCURRENCY=1
PHOTO_FACE_DETECTION_THRESHOLD=0.8
PHOTO_FACE_MATCH_THRESHOLD=0.4

# Generate a password for a new database, or use the existing volume's password.
POSTGRES_USER=photo
POSTGRES_PASSWORD=replace-with-a-generated-password
POSTGRES_DB=photo
PHOTO_POSTGRES_HOST=localhost
PHOTO_POSTGRES_PORT=55432
# Optional host-side override: PHOTO_DATABASE_URL (keep credentials in .env).

# Preview cache LRU limits (the worker process enforces these). Previews are
# disposable: after eviction a request returns 202 and re-encodes from the
# immutable original, so the cost of a small budget is only re-encode latency.
# 0 disables eviction. A 50 GB budget holds ~30k-100k preview sets.
PHOTO_CACHE_MAX_BYTES=53687091200
PHOTO_CACHE_EVICTION_INTERVAL=300
PHOTO_CACHE_EVICT_TARGET_RATIO=0.9

# Hourly PostgreSQL custom-format backups in the media S3 bucket. The default
# keeps seven days. Back up that bucket independently to survive NAS/S3 loss.
PHOTO_POSTGRES_BACKUP_PREFIX=backups/postgres
PHOTO_POSTGRES_BACKUP_INTERVAL_SECONDS=3600
PHOTO_POSTGRES_BACKUP_RETENTION=168

# For authenticated S3, set PHOTO_S3_ANONYMOUS=false and supply credentials here
# or use the normal AWS credential chain. Leave these empty for anonymous S3.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
