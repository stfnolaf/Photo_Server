# Copy to .env and fill in your deployment values. Never commit the filled file.
PHOTO_S3_ENDPOINT=http://s3-host:8333
PHOTO_S3_BUCKET=photo-library
PHOTO_S3_ANONYMOUS=true
PHOTO_DATA_DIR=.runtime
PHOTO_API_BIND=0.0.0.0
PHOTO_API_PORT=8000
PHOTO_WEB_BIND=0.0.0.0
PHOTO_WEB_PORT=3000
PHOTO_MAX_BATCH_FILES=1000
PHOTO_MAX_FILE_BYTES=536870912
PHOTO_UPLOAD_WORKERS=4
PHOTO_UPLOAD_ABANDON_SECONDS=86400
PHOTO_WORKER_THREADS=4
PHOTO_UPLOAD_PART_BYTES=8388608
# Comma-separated browser origins, for example http://192.168.8.50:3000
PHOTO_CORS_ORIGINS=

# Local CUDA analysis. The default model is the 6.1 GB Q4_K_M Qwen3-VL 8B
# instruct build. PHOTO_FACE_MODEL_DIR must contain the verified YuNet, SFace
# alignment, and AdaFace IR101 files produced by the sibling face-scanner.
PHOTO_AI_MODEL=qwen3-vl:8b-instruct-q4_K_M
PHOTO_AI_TIMEOUT_SECONDS=600
PHOTO_AI_CONTEXT_TOKENS=4096
PHOTO_AI_FACE_MAX_IMAGE_SIDE=2000
PHOTO_AI_VLM_MAX_IMAGE_SIDE=1280
PHOTO_FACE_MODEL_DIR=../face-scanner/runtime/raw-jpeg/models
PHOTO_FACE_DETECTION_THRESHOLD=0.8
PHOTO_FACE_MATCH_THRESHOLD=0.4

# Generate a password for a new database, or use the existing volume's password.
POSTGRES_USER=photo
POSTGRES_PASSWORD=replace-with-a-generated-password
POSTGRES_DB=photo
PHOTO_POSTGRES_HOST=localhost
PHOTO_POSTGRES_PORT=55432
# Optional host-side override: PHOTO_DATABASE_URL (keep credentials in .env).

# Preview cache LRU limits (the worker process enforces these). Previews are
# disposable: after eviction a request returns 202 and re-encodes from the
# immutable original, so the cost of a small budget is only re-encode latency.
# 0 disables eviction. A 50 GB budget holds ~30k-100k preview sets.
PHOTO_CACHE_MAX_BYTES=53687091200
PHOTO_CACHE_EVICTION_INTERVAL=300
PHOTO_CACHE_EVICT_TARGET_RATIO=0.9

# Hourly PostgreSQL custom-format backups in the media S3 bucket. The default
# keeps seven days. Back up that bucket independently to survive NAS/S3 loss.
PHOTO_POSTGRES_BACKUP_PREFIX=backups/postgres
PHOTO_POSTGRES_BACKUP_INTERVAL_SECONDS=3600
PHOTO_POSTGRES_BACKUP_RETENTION=168

# For authenticated S3, set PHOTO_S3_ANONYMOUS=false and supply credentials here
# or use the normal AWS credential chain. Leave these empty for anonymous S3.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
